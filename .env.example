# Example environment variables for youtube-optimizer
PORT=3000

# YouTube API
YT_CLIENT_ID=your-client-id.apps.googleusercontent.com
YT_CLIENT_SECRET=your-client-secret
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
CHANNEL_ID=your-channel-id

# Google Business Profile (Reviews) API
REVIEWS_OAUTH_REDIRECT_URI=http://localhost:3000/auth/reviews/callback

# Gemini / Vertex AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash-lite

# MongoDB
MONGODB_URI=mongodb://localhost:27017/youtube-optimizer

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Processing Configuration
BATCH_SIZE=5
MAX_RETRIES=3
DAILY_QUOTA_LIMIT=9000

# Optional: service account project for Vertex endpoints
GCP_PROJECT=your-gcp-project-id
